# --- Garmin Connect ---
# Used only on first login / when the token cache is invalidated (~monthly).
# After a successful login the OAuth1 token is cached (locally in garmin_tokens/,
# on Fly.io in the volume) and credentials sit idle until it expires.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- Strava OAuth ---
# Get CLIENT_ID and CLIENT_SECRET from https://www.strava.com/settings/api
# Run reauth_strava.py once to populate the three token fields below.
# ACCESS_TOKEN / EXPIRES_AT refresh themselves; REFRESH_TOKEN is long-lived.
CLIENT_ID=
CLIENT_SECRET=
ACCESS_TOKEN=
REFRESH_TOKEN=
EXPIRES_AT=0

# --- Strava web session ---
# Required for the crop/truncate step (the OAuth API doesn't expose it).
# Capture from a logged-in browser: DevTools → Application → Cookies →
# https://www.strava.com → `_strava4_session` → copy the Value column.
# Auto-rotates on each successful crop, so it effectively never expires as
# long as sync runs at least every few weeks.
STRAVA_SESSION_COOKIE=

# --- Strava webhook (for auto-trigger) ---
# Any random string; sync_server checks incoming webhook-verify GETs against
# it. Then run subscribe_webhook.py once to register the subscription.
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Optional: override the callback URL registered by subscribe_webhook.py.
# Defaults to the Fly.io domain hardcoded there.
STRAVA_WEBHOOK_CALLBACK_URL=

# --- iOS Shortcut backup trigger ---
# Shared secret the Shortcut sends in the X-Sync-Secret header to POST /sync.
SYNC_SECRET=

# --- Deployment (Fly.io) ---
# Set on the deployed server only. Points credential persistence + the Garmin
# token cache at the mounted volume so they survive restarts. Locally leave
# unset (falls back to .env + ./garmin_tokens/).
DATA_DIR=
# Base64 of garmin_tokens/garmin_tokens.json, used to bootstrap the token onto
# a fresh volume. Regenerate after each Garmin re-auth:
#   python -c "import base64,pathlib; print(base64.b64encode(pathlib.Path('garmin_tokens/garmin_tokens.json').read_bytes()).decode())"
GARMIN_TOKEN_B64=
